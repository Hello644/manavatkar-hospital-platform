# Two doors into one server.
#
#   PUBLIC_DOMAIN (manwatkarhospital.in) — faces the internet. Serves the
#   marketing pages and the booking form and NOTHING else. Certificates are
#   issued automatically over HTTP-01, which needs ports 80/443 forwarded.
#
#   LAN_HOSTNAME (e.g. hms.hospital.lan) — faces the hospital LAN. Serves the
#   full clinical system over HTTPS using Caddy's own local CA (`tls internal`),
#   so staff get real encryption with no dependency on the internet being up.
#   That matters: PLAN.md requires the OPD to keep running through an outage,
#   and a public CA cannot renew a certificate for a private hostname offline.
#
# The path allowlist below is the first of two defences. The second is
# apps.site.middleware.PublicSiteIsolationMiddleware, which refuses the same
# requests inside Django in case this file is ever wrong or bypassed.

{$PUBLIC_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Only the public website. Both slashed and unslashed forms are listed so
	# Django's APPEND_SLASH redirect can complete.
	@public {
		path / /doctors /doctors/ /services /services/ /contact /contact/ /book /book/ /book/done /book/done/ /robots.txt /sitemap.xml /favicon.ico /static/*
	}

	handle @public {
		reverse_proxy web:8000
	}

	# Everything else does not exist as far as the internet is concerned:
	# /patients/, /opd/, /rx/, /admin/, /login/, /attendance/, /voice/ …
	handle {
		respond "Not found" 404
	}
}

# Redirect www to the canonical apex.
www.{$PUBLIC_DOMAIN:localhost} {
	redir https://{$PUBLIC_DOMAIN:localhost}{uri} permanent
}

# The clinical system, LAN only. Reachable at this name because the hospital's
# local DNS (or each device's hosts file) points it at the server's fixed LAN
# address — it is never published in public DNS.
{$LAN_HOSTNAME:hms.hospital.lan} {
	encode zstd gzip
	tls internal
	reverse_proxy web:8000
}
