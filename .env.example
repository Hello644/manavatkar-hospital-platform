# ── Local development (python manage.py runserver) ───────────────────────────
# DEBUG=1 is for a developer laptop only. The container/server always runs with
# DEBUG=0 (docker-compose sets it), which activates the secure-secret guard.
DJANGO_DEBUG=1

# REQUIRED on the server. Generate a real value and paste it here:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to boot with DEBUG=0 while this is a placeholder.
DJANGO_SECRET_KEY=change-this-before-use

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
HOSPITAL_UHID_CODE=DMH
HOSPITAL_PRIVACY_NOTICE_VERSION=2026-07-02-v1

# Optional server TLS hardening (set once a real domain + cert are in place):
# DJANGO_HSTS_SECONDS=31536000

# Optional: AI clinical assistant (apps.assist) — off unless enabled + keyed.
# OPD_AI_ENABLED=1
# OPD_ANTHROPIC_API_KEY=sk-ant-...

# Facial attendance kiosk. Set a long random token to activate the kiosk, and
# point at the face service to enable the face path (else PIN-only).
# KIOSK_DEVICE_TOKEN=change-this-kiosk-token
# FACE_SERVICE_URL=http://facesvc:8080

# ── Docker defaults ──────────────────────────────────────────────────────────
POSTGRES_DB=hospital
POSTGRES_USER=hospital
# REQUIRED on the server — replace before `docker compose up`.
POSTGRES_PASSWORD=change-this-db-password
APP_DOMAIN=localhost
